[], "sources": [], "generated_text_license": null, "attributions": []}, {"id": "die-forelle-wc-0039", "piece_id": "die-forelle", "kind": "web", "evidence_type": "web_coaching", "usage_class": null, "topic": "", "question": "", "text": "「송어」는 변형 유절 형식으로, 처음 두 절은 동일하여 민요 같은 느낌을 주고, 세 번째 절은 음악이 다소 달라져 낚시꾼이 송어를 잡는 긴장을 담아낸다고 설명한다.", "measure_ranges": [], "is_local": false, "measure_scope": "global", "measure_status": null, "scope_match": "general_evidence", "generation_role": "general_support", "selected_range_claim_authority": null, "in_requested_scope": true, "score": 0.014914, "text_score": 0, "dense_score": 0.0, "dense_content_score": 0.0, "fusion_score": 0.0, "retrieval_mode": "lexical", "measure_score": 0, "alias_score": 0.0, "concept_coverage": 0.0, "content_concept_coverage": 0.0, "answer_relation_score": 0.0, "semantic_match_type": "strict", "source_ids": [], "web_source_ids": [], "sumijo_source": null, "claim_ids": [], "sources": [], "generated_text_license": null, "attributions": []}, {"id": "die-forelle-wc-5017", "piece_id": "die-forelle", "kind": "web", "evidence_type": "web_coaching", "usage_class": null, "topic": "", "question": "", "text": "강사는 1절이 A+B, 2절이 그와 완전히 같은 A+B(슈베르트의 첫 악보에는 도돌이표로 표기됨)이고, 3절은 앞부분이 C로 바뀐 C+B 형태여서 한 부분만 달라지는 '변형된(변주된) 유절가곡' 형식이라고 설명한다.", "measure_ranges": [], "is_local": false, "measure_scope": "global", "measure_status": null, "scope_match": "general_evidence", "generation_role": "general_support", "selected_range_claim_authority": null, "in_requested_scope": true, "score": 0.01397, "text_score": 0, "dense_score": 0.0, "dense_content_score": 0.0, "fusion_score": 0.0, "retrieval_mode": "lexical", "measure_score": 0, "alias_score": 0.0, "concept_coverage": 0.0, "content_concept_coverage": 0.0, "answer_relation_score": 0.0, "semantic_match_type": "strict", "source_ids": [], "web_source_ids": [], "sumijo_source": null, "claim_ids": [], "sources": [], "generated_text_license": null, "attributions": []}], "evidence_notices": [{"record_i